<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>br.com.fiap.fiapx</groupId>
    <artifactId>fiapx-processing-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>fiapx-processing-service</name>
    <description>Processamento assíncrono de vídeos FIAP X</description>
    <properties>
        <java.version>21</java.version>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-liquibase</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>media-integration</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                <configuration><includes><include>**/ProcessingMediaIT.java</include></includes></configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>postgres-integration</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
                <configuration><includes><include>**/ProcessingPostgresIT.java</include></includes></configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
    <build>
        <finalName>app</finalName>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>${jacoco.version}</version>
                <configuration><excludes><exclude>**/ProcessingApplication.class</exclude></excludes></configuration>
                <executions>
                    <execution><id>agent</id><goals><goal>prepare-agent</goal></goals></execution>
                    <execution>
                        <id>coverage</id><phase>verify</phase><goals><goal>report</goal><goal>check</goal></goals>
                        <configuration><rules><rule><element>BUNDLE</element><limits>
                            <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                            <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                        </limits></rule></rules></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
